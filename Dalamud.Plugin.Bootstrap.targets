<?xml version="1.0" encoding="utf-8"?>
<Project>
  <PropertyGroup>
    <DalamudLibPath Condition="$(DALAMUD_HOME) != ''">$(DALAMUD_HOME)</DalamudLibPath>
    <DalamudLibPath Condition="$(DalamudLibPath) == '' AND $([MSBuild]::IsOSPlatform('Windows'))">$(appdata)\XIVLauncher\addon\Hooks\dev</DalamudLibPath>
    <DalamudLibPath Condition="Exists('$(appdata)\XIVLauncherCN\addon\Hooks\dev\')">$(appdata)\XIVLauncherCN\addon\Hooks\dev</DalamudLibPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <AssemblySearchPaths>$(AssemblySearchPaths);$(DalamudLibPath)</AssemblySearchPaths>
  </PropertyGroup>
  <Target Name="Message" BeforeTargets="BeforeBuild">
    <Message Text="Dalamud.Plugin: root at $(DalamudLibPath)" Importance="high" />
  </Target>
</Project>
