<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <LangVersion>preview</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>NewFolder3.ContractTests</AssemblyName>
  </PropertyGroup>
  <PropertyGroup>
    <DalamudLibPath Condition="$([MSBuild]::IsOSPlatform('Windows'))">$(appdata)\XIVLauncher\addon\Hooks\dev\</DalamudLibPath>
    <DalamudLibPath Condition="Exists('$(appdata)\XIVLauncherCN\addon\Hooks\dev\')">$(appdata)\XIVLauncherCN\addon\Hooks\dev\</DalamudLibPath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\CommunityEvidenceCollector.cs" Link="CommunityEvidenceCollector.cs" />
    <Compile Include="..\..\CommunityUsageTelemetryCollector.cs" Link="CommunityUsageTelemetryCollector.cs" />
    <Compile Include="..\..\NewFolder3AccessGate.cs" Link="NewFolder3AccessGate.cs" />
    <Compile Include="..\..\NewFolder3BuildProfile.cs" Link="NewFolder3BuildProfile.cs" />
    <ProjectReference Include="..\..\shared\DeepDungeon.Fsd\Core\DeepDungeon.Fsd.Core.csproj" />
    <ProjectReference Include="..\..\shared\DeepDungeon.Fsd\Dalamud\DeepDungeon.Fsd.Dalamud.csproj" />
    <Reference Include="Dalamud"><HintPath>$(DalamudLibPath)Dalamud.dll</HintPath><Private>True</Private></Reference>
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\NewFolder3.json" Link="NewFolder3.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\NewFolder3-release.json" Link="NewFolder3-release.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
